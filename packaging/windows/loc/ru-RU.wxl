<?xml version="1.0" encoding="utf-8"?>
<WixLocalization
  xmlns="http://wixtoolset.org/schemas/v4/wxl"
  Culture="ru-RU">
  <String
    Id="UsqueRemoveDataTitle"
    Value="Параметры удаления" />
  <String
    Id="UsqueRemoveDataDescription"
    Value="Выберите, сохранять ли данные для последующей переустановки." />
  <String
    Id="UsqueRemoveDataCheckbox"
    Value="Удалить профили, параметры, журналы, кэш и идентичности WARP этого пользователя Windows." />
  <String
    Id="UsqueRemoveDataWarning"
    Value="Это нельзя отменить. Оставьте параметр снятым, чтобы сохранить локальные данные. Другие пользователи Windows не затрагиваются." />
  <String
    Id="UsqueRepairTitle"
    Value="Восстановление не поддерживается" />
  <String
    Id="UsqueRepairDescription"
    Value="Восстановление может прервать привилегированное состояние восстановления сети. Выберите «Удалить», чтобы удалить Usque, затем установите его снова; данные пользователя сохраняются, если явно не выбрать удаление. Установка более нового выпуска также поддерживается." />
  <String
    Id="UsqueRepairOk"
    Value="ОК" />
</WixLocalization>
