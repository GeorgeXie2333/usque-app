<?xml version="1.0" encoding="utf-8"?>
<WixLocalization
  xmlns="http://wixtoolset.org/schemas/v4/wxl"
  Culture="fa-IR">
  <String
    Id="UsqueRemoveDataTitle"
    Value="گزینه‌های حذف" />
  <String
    Id="UsqueRemoveDataDescription"
    Value="انتخاب کنید که داده‌ها برای نصب دوباره در آینده نگه داشته شوند یا نه." />
  <String
    Id="UsqueRemoveDataCheckbox"
    Value="نمایه‌ها، تنظیمات، گزارش‌ها، حافظهٔ نهان و هویت‌های WARP این کاربر ویندوز را حذف کن." />
  <String
    Id="UsqueRemoveDataWarning"
    Value="این کار برگشت‌پذیر نیست. برای نگه داشتن داده‌های محلی گزینه را خالی بگذارید. سایر کاربران ویندوز تحت تأثیر نیستند." />
  <String
    Id="UsqueRepairTitle"
    Value="تعمیر پشتیبانی نمی‌شود" />
  <String
    Id="UsqueRepairDescription"
    Value="تعمیر ممکن است وضعیت بازیابی شبکهٔ دارای امتیاز را قطع کند. Remove را انتخاب کنید تا Usque حذف شود، سپس دوباره نصب کنید؛ مگر اینکه حذف را صریح انتخاب کنید، داده‌های کاربر حفظ می‌شود. نصب نسخهٔ جدیدتر نیز پشتیبانی می‌شود." />
  <String
    Id="UsqueRepairOk"
    Value="تأیید" />
</WixLocalization>
