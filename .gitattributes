# Keep repository text deterministic across Windows, Android and CI hosts.
* text=auto eol=lf

# Windows command scripts require CRLF for reliable cmd.exe execution.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary application and documentation assets.
*.dll binary
*.exe binary
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.zip binary
*.pdf binary

# Preserve upstream BoringSSL whitespace verbatim. Its generated assembly,
# historical licenses, and patch fixtures intentionally contain whitespace
# that Git would otherwise report as project-authored errors.
third_party/boring-sys-4.22.0/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

# Two unchanged smoltcp archive lines contain deliberate upstream whitespace:
# an example comment and a fixed-width test snapshot. Preserve their bytes.
third_party/smoltcp-0.14.0/examples/sixlowpan_benchmark.rs whitespace=-blank-at-eol
third_party/smoltcp-0.14.0/tests/snapshots/netsim__netsim.snap whitespace=-blank-at-eol
# Keep the archived license's final blank line verbatim as well.
third_party/smoltcp-0.14.0/LICENSE-0BSD.txt whitespace=-blank-at-eof

# The native source inventory hashes these upstream MSVC examples with CRLF.
# Preserve their bytes when staging and checking out on any host.
third_party/lz4-1.10.0/lib/dll/example/fullbench-dll.sln -text
third_party/lz4-1.10.0/lib/dll/example/fullbench-dll.vcxproj -text
