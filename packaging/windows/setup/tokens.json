{
  "schema": 1,
  "colors": {
    "canvas": {"flutter": "UsqueTokens.canvas", "light": "#F5F4F1", "dark": "#0E0E10"},
    "surface": {"flutter": "ColorScheme.surface", "light": "#FFFFFF", "dark": "#18181A"},
    "field": {"flutter": "ColorScheme.surfaceContainerLow", "light": "#FAF9F6", "dark": "#1A1A1D"},
    "pressed": {"flutter": "ColorScheme.surfaceContainerHigh", "light": "#EDEBE4", "dark": "#26262A"},
    "ink": {"flutter": "ColorScheme.onSurface", "light": "#1C1B18", "dark": "#ECEAE6"},
    "muted": {"flutter": "ColorScheme.onSurfaceVariant", "light": "#5D5A52", "dark": "#A5A29B"},
    "hairline": {"flutter": "UsqueTokens.hairline", "light": "#E4E1DA", "dark": "#2A2A2F"},
    "hairline_strong": {"flutter": "UsqueTokens.hairlineStrong", "light": "#CFCABF", "dark": "#3C3C43"},
    "primary": {"flutter": "ColorScheme.primary", "light": "#C2500C", "dark": "#FFA45C"},
    "on_primary": {"flutter": "ColorScheme.onPrimary", "light": "#FFFFFF", "dark": "#441800"},
    "caution": {"flutter": "UsqueTokens.caution", "light": "#A15C00", "dark": "#F2B24C"},
    "danger": {"flutter": "UsqueTokens.danger", "light": "#B3261E", "dark": "#FFB4AB"},
    "on_danger": {"flutter": "ColorScheme.onError", "light": "#FFFFFF", "dark": "#690005"},
    "success": {"flutter": "UsqueTokens.success", "light": "#128257", "dark": "#4ADE9C"}
  },
  "ratios": {
    "tint": {"flutter": "UsqueTokens.tint", "light": 0.12, "dark": 0.16}
  },
  "derived": {
    "primary_pressed": {"scale": ["primary", 0.9]},
    "danger_pressed": {"scale": ["danger", 0.9]},
    "success_soft": {"mix": ["success", "canvas", "tint"]},
    "caution_soft": {"mix": ["caution", "canvas", "tint"]},
    "danger_soft": {"mix": ["danger", "canvas", "tint"]},
    "disabled_ink": {"mix": ["ink", "canvas", 0.38]},
    "disabled_fill": {"mix": ["ink", "canvas", 0.12]},
    "caution_fill": {"mix": ["caution", "canvas", 0.10]},
    "caution_border": {"mix": ["caution", "canvas", 0.30]},
    "danger_fill": {"mix": ["danger", "canvas", 0.09]},
    "danger_border": {"mix": ["danger", "canvas", 0.30]}
  },
  "metrics": {
    "radius_control": {"flutter": "UsqueRadii.control", "value": 12},
    "radius_chip": {"flutter": "UsqueRadii.chip", "value": 10},
    "radius_checkbox": {"flutter": "CheckboxThemeData.radius", "value": 5},
    "stroke_strong": {"flutter": "CheckboxThemeData.sideWidth", "value": 1.6},
    "button_min_height": {"flutter": "FilledButtonThemeData.minimumHeight", "value": 48},
    "motion_base_ms": {"flutter": "UsqueMotion.base", "value": 200},
    "motion_scan_ms": {"flutter": "UsqueMotion.scan", "value": 1600},
    "progress_height": {"value": 6},
    "focus_ring": {"value": 2},
    "stall_ms": {"value": 1200}
  }
