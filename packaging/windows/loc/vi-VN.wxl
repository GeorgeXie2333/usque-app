<?xml version="1.0" encoding="utf-8"?>
<WixLocalization
  xmlns="http://wixtoolset.org/schemas/v4/wxl"
  Culture="vi-VN">
  <String
    Id="UsqueRemoveDataTitle"
    Value="Tùy chọn gỡ cài đặt" />
  <String
    Id="UsqueRemoveDataDescription"
    Value="Chọn có giữ dữ liệu cho lần cài đặt lại sau này hay không." />
  <String
    Id="UsqueRemoveDataCheckbox"
    Value="Xóa hồ sơ, cài đặt, nhật ký, bộ nhớ đệm và danh tính WARP của người dùng Windows này." />
  <String
    Id="UsqueRemoveDataWarning"
    Value="Không hoàn tác được. Để trống tùy chọn này nếu muốn giữ dữ liệu cục bộ. Người dùng Windows khác không bị ảnh hưởng." />
  <String
    Id="UsqueRepairTitle"
    Value="Không hỗ trợ sửa chữa" />
  <String
    Id="UsqueRepairDescription"
    Value="Sửa chữa có thể làm gián đoạn trạng thái khôi phục mạng đặc quyền. Chọn Gỡ để gỡ Usque rồi cài lại; dữ liệu người dùng được giữ trừ khi bạn chọn xóa rõ ràng. Cài bản phát hành mới hơn cũng được hỗ trợ." />
  <String
    Id="UsqueRepairOk"
    Value="OK" />
</WixLocalization>
