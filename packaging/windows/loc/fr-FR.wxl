<?xml version="1.0" encoding="utf-8"?>
<WixLocalization
  xmlns="http://wixtoolset.org/schemas/v4/wxl"
  Culture="fr-FR">
  <String
    Id="UsqueRemoveDataTitle"
    Value="Options de désinstallation" />
  <String
    Id="UsqueRemoveDataDescription"
    Value="Choisissez si les données doivent être conservées pour une réinstallation ultérieure." />
  <String
    Id="UsqueRemoveDataCheckbox"
    Value="Supprimer les profils, paramètres, journaux, caches et identités WARP de cet utilisateur Windows." />
  <String
    Id="UsqueRemoveDataWarning"
    Value="Cette action est irréversible. Laissez l’option décochée pour conserver les données locales. Les autres utilisateurs Windows ne sont pas concernés." />
  <String
    Id="UsqueRepairTitle"
    Value="La réparation n’est pas prise en charge" />
  <String
    Id="UsqueRepairDescription"
    Value="Une réparation pourrait interrompre l’état de récupération réseau privilégié. Choisissez Supprimer pour désinstaller Usque, puis réinstallez-le ; les données utilisateur sont conservées sauf si vous sélectionnez explicitement leur suppression. L’installation d’une version plus récente est également prise en charge." />
  <String
    Id="UsqueRepairOk"
    Value="OK" />
</WixLocalization>
